{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "episode.schema.json",
  "title": "A famous episode of the Matter of Britain",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "act", "order", "summary", "retelling", "voices", "passages", "cost"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "act": { "enum": ["before", "making", "flowering", "grail", "fall", "after"] },
    "order": { "type": "integer" },
    "branch": { "enum": ["chronicle", "welsh", "french", "german", "english", "reception"] },
    "summary": { "type": "string", "minLength": 20 },
    "also_known_as": { "type": "array", "items": { "type": "string" } },
    "retelling": { "type": "string", "minLength": 400 },
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voice", "take"],
        "properties": {
          "voice": { "type": "string" },
          "term": { "type": "string" },
          "take": { "type": "string", "minLength": 20 },
          "quote_id": { "type": "string" },
          "gap_note": { "type": "string" }
        }
      }
    },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit"],
        "properties": {
          "unit": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "cost": { "type": "string", "minLength": 40 },
    "divergence": { "type": "string" },
    "cuts": { "type": "array", "items": { "type": "string" } },
    "characters": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "gap_note": { "type": "string" }
  }
}
