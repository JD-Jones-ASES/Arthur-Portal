{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary.schema.json",
  "title": "Glossary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "rights", "entries"],
  "properties": {
    "schema_version": { "type": "integer" },
    "source": { "type": "string" },
    "rights": { "type": "string" },
    "note": { "type": "string" },
    "corrections": { "type": "array" },
    "counts": { "type": "object" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "match", "gloss", "kind"],
        "properties": {
          "term": { "type": "string", "minLength": 2 },
          "match": { "type": "string", "minLength": 2 },
          "gloss": { "type": "string", "minLength": 2 },
          "kind": { "enum": ["archaic", "false-friend"] }
        }
      }
    }
  }
}
