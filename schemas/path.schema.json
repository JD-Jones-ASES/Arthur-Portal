{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path.schema.json",
  "title": "A guided reading route",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "order",
    "title",
    "blurb",
    "stops"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "order": {
      "type": "integer"
    },
    "title": {
      "type": "string"
    },
    "minutes": {
      "type": "integer"
    },
    "blurb": {
      "type": "string",
      "minLength": 30
    },
    "note": {
      "type": "string"
    },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episode": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "description": "At least two: a route needs somewhere to start and somewhere to end. The five-minute route is legitimately two stops."
    }
  }
}
