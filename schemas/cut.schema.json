{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cut.schema.json",
  "title": "A throughline (one of the seven cuts)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "n", "title", "gloss", "question", "essay", "cost", "takes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "n": { "type": "integer", "minimum": 1, "maximum": 7 },
    "title": { "type": "string" },
    "short": { "type": "string" },
    "gloss": { "type": "string", "minLength": 30 },
    "question": { "type": "string", "minLength": 20, "description": "the question this throughline asks the canon" },
    "hinge": { "type": "boolean" },
    "essay": { "type": "string", "minLength": 400 },
    "cost": { "type": "string", "minLength": 60 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "takes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["voice", "term", "take"],
        "properties": {
          "voice": { "type": "string" },
          "term": { "type": "string", "minLength": 5, "description": "the version in a phrase" },
          "take": { "type": "string", "minLength": 20 },
          "quote_id": { "type": "string" },
          "gap_note": { "type": "string" }
        }
      }
    },
    "divergence": { "type": "string", "description": "where the voices materially contradict each other" },
    "episodes": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } }
  }
}
