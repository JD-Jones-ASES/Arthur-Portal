---
import Layout from "../../components/Layout.astro";
import Ornament from "../../components/Ornament.astro";
import { withBase } from "../../lib/site.js";
import { essays, quoteById } from "../../lib/portal-data.js";
import { mdToHtml } from "../../lib/markdown.js";

export function getStaticPaths() {
  return essays().map((e) => ({ params: { essay: e.id }, props: { essay: e } }));
}
const { essay } = Astro.props;
const cited = (essay.quotes ?? []).map((q) => quoteById(q)).filter(Boolean);
---

<Layout title={essay.title} description={essay.standfirst} current="/method">
  <div class="page-head">
    <span class="rubric">Essay</span>
    <h1>{essay.title}</h1>
    {essay.subtitle && <p class="muted">{essay.subtitle}</p>}
    <p class="lede">{essay.standfirst}</p>
  </div>

  <div class="essay-grid">
    <article class="prose essay-body" set:html={mdToHtml(essay.body)} />

    <aside class="essay-aside">
      <section class="margin-block">
        <h2 class="rubric">Every quotation used</h2>
        <p class="small muted">
          {cited.length} passages, each located in its source by the gate and linked to the exact
          place it sits.
        </p>
        <ul class="margin-list">
          {cited.map((q) => (
            <li data-branch={q.branch ?? undefined}>
              <a class="margin-list__q" href={withBase(`/quotes/#${q.id}`)}>
                &ldquo;{q.text.slice(0, 58)}{q.text.length > 58 ? "…" : ""}&rdquo;
              </a>
              <span class="small muted">{q.voice}</span>
              {q.spine && (
                <> &middot; <a class="small" href={withBase(`/read/${q.work}/${q.spine.unit}/#p${q.spine.paragraph}`)}>read in place</a></>
              )}
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</Layout>

<style>
  .essay-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(13rem, 17rem);
    gap: var(--s7);
    align-items: start;
  }
  @media (max-width: 1000px) { .essay-grid { grid-template-columns: 1fr; } }
  .essay-aside { position: sticky; top: 5rem; font-size: 0.92rem; }
  @media (max-width: 1000px) { .essay-aside { position: static; border-top: 1px solid var(--line); padding-top: var(--s5); } }
  .essay-body { font-size: 1.06rem; line-height: 1.66; }
  .essay-body :global(h2) { font-size: 1.28rem; margin-top: var(--s8); }
  .essay-body :global(p:first-of-type::first-letter) {
    float: left;
    font-family: var(--font-display);
    font-size: 3.1em;
    line-height: 0.85;
    padding: 0.05em 0.09em 0 0;
    color: var(--rubric);
    font-weight: 600;
  }
</style>
