---
import Layout from "../../components/Layout.astro";
import Ornament from "../../components/Ornament.astro";
import FollowRead from "../../components/FollowRead.astro";
import { withBase } from "../../lib/site.js";
import { followById, workById } from "../../lib/portal-data.js";

const follow = followById("the-grail-quest");
const work = workById(follow.work);
---

<Layout
  title="Follow the quest"
  description="A guided read of Malory's Grail quest — seventeen chapters, in order, with a line of commentary at each stop."
  current="/grail"
  branch={work.branch}
>
  <FollowRead follow={follow} />

  <Ornament />

  <section class="narrow narrow--flush">
    <span class="rubric">Then</span>
    <h2>Where to go from here</h2>
    <p>
      For the argument rather than the narrative:
      <a href={withBase("/grail/versions/")}>the six Grails compared</a>,
      <a href={withBase("/grail/unasked-question/")}>the unasked question in four traditions</a>, or
      <a href={withBase("/throughlines/the-grail/")}>the Grail as a throughline</a>.
    </p>
    <p>
      For what the quest costs the kingdom it left behind:
      <a href={withBase("/follow/the-fall/")}>Follow the Fall</a> picks up four books later and runs
      to the last page.
    </p>
  </section>
</Layout>
