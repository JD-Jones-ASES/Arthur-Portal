---
import Layout from "../../components/Layout.astro";
import Ornament from "../../components/Ornament.astro";
import { withBase } from "../../lib/site.js";
import { paths, episodeById, workById, units as getUnits } from "../../lib/portal-data.js";

export function getStaticPaths() {
  return paths().map((p) => ({ params: { path: p.id }, props: { path: p } }));
}
const { path } = Astro.props;

const stops = path.stops.map((s) => {
  if (s.episode) {
    const ep = episodeById(s.episode);
    const first = ep?.passages?.[0];
    const work = first ? workById(first.unit.split("-").slice(0, -2).join("-")) : null;
    return { kind: "episode", ep, note: s.note ?? ep?.summary, work, unit: work ? getUnits(work.id)[first.unit] : null };
  }
  const work = workById(s.unit.split("-").slice(0, -2).join("-"));
  return { kind: "unit", note: s.note, work, unit: work ? getUnits(work.id)[s.unit] : null };
}).filter((s) => s.ep || s.unit);
---

<Layout title={path.title} description={path.blurb} current="/start">
  <div class="page-head">
    <span class="rubric">A route &middot; {path.stops.length} stops</span>
    <h1>{path.title}</h1>
    <p class="lede">{path.blurb}</p>
    {path.note && <p>{path.note}</p>}
  </div>

  <ol class="follow-stops">
    {stops.map((s, i) => (
      <li class="fstop" data-branch={s.ep?.branch ?? s.work?.branch}>
        <div class="fstop__rail"><span class="fstop__n">{i + 1}</span></div>
        <div class="fstop__body">
          {s.kind === "episode" ? (
            <a class="fstop__chapter" href={withBase(`/stories/${s.ep.id}/`)}>
              <span class="fstop__label">Story</span>
              <span class="fstop__title">{s.ep.title}</span>
            </a>
          ) : (
            <a class="fstop__chapter" href={withBase(`/read/${s.work.id}/${s.unit.id}/`)}>
              <span class="fstop__label">{s.work.short} {s.unit.label}</span>
              <span class="fstop__title">{s.unit.title}</span>
            </a>
          )}
          {s.note && <p class="fstop__note">{s.note}</p>}
          {s.kind === "episode" && s.unit && (
            <p class="small"><a href={withBase(`/read/${s.work.id}/${s.unit.id}/`)}>Read it in {s.work.short} &rarr;</a></p>
          )}
        </div>
      </li>
    ))}
  </ol>

  <Ornament />
  <p class="small"><a href={withBase("/paths/")}>&larr; All routes</a></p>
</Layout>

<style>
  .follow-stops { list-style: none; margin: var(--s6) 0 0; padding: 0; }
  .fstop { display: grid; grid-template-columns: 3rem 1fr; gap: var(--s4); }
  .fstop__rail { position: relative; display: flex; justify-content: center; }
  .fstop__rail::before { content: ""; position: absolute; top: 0; bottom: -1px; width: 2px; background: color-mix(in srgb, var(--branch) 30%, transparent); }
  .fstop:last-child .fstop__rail::before { height: 1.6rem; bottom: auto; }
  .fstop__n { position: relative; z-index: 1; width: 1.9rem; height: 1.9rem; border-radius: 50%; display: grid; place-items: center; background: var(--paper); border: 2px solid var(--branch); color: var(--branch-ink); font-family: var(--font-rubric); font-size: 0.8rem; }
  .fstop__body { padding-bottom: var(--s6); max-width: 40rem; }
  .fstop__chapter { display: block; text-decoration: none; color: inherit; }
  .fstop__chapter:hover .fstop__title { color: var(--branch-ink); text-decoration: underline; }
  .fstop__label { display: block; font-family: var(--font-rubric); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); }
  .fstop__title { display: block; font-family: var(--font-display); font-size: 1.02rem; line-height: 1.35; margin-top: 0.15em; }
  .fstop__note { margin: var(--s3) 0 0; color: var(--ink-soft); }
  @media (max-width: 560px) { .fstop { grid-template-columns: 2.2rem 1fr; gap: var(--s3); } }
</style>
