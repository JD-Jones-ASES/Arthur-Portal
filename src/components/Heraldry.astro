---
/**
 * A shield drawn from a traditional blazon.
 *
 * The arms attributed to Arthur's knights are a late-medieval invention — the
 * romances themselves rarely give a knight consistent arms, and the armorials
 * that assign them date from the fourteenth and fifteenth centuries, well after
 * the stories were written. They are therefore presented here as a tradition,
 * with the blazon printed alongside, and a knight with no well-attested arms
 * gets a plain device rather than an invented one. Everything is drawn in code:
 * no third-party artwork is used anywhere on this site.
 */

const TINCTURE = {
  azure: "#2f5288",
  gules: "#a8321e",
  vert: "#3f6b4a",
  purpure: "#6b4a7d",
  sable: "#23201a",
  or: "#c39a3e",
  argent: "#f4eee1",
};

const { blazon = null, name = "", size = 88 } = Astro.props;

/** Parse the small subset of blazon this site actually uses. */
function read(text) {
  if (!text) return null;
  const t = text.toLowerCase();
  const field = Object.keys(TINCTURE).find((k) => t.startsWith(k)) ?? "argent";
  const charge = Object.keys(TINCTURE).filter((k) => k !== field).find((k) => t.includes(k)) ?? "or";
  let device = "plain";
  if (t.includes("crown")) device = "crowns";
  else if (t.includes("bend")) device = "bends";
  else if (t.includes("eagle")) device = "eagle";
  else if (t.includes("cross")) device = "cross";
  else if (t.includes("lion")) device = "lion";
  return { field, charge, device };
}

const arms = read(blazon?.text);
const f = arms ? TINCTURE[arms.field] : "var(--paper-sunk)";
const c = arms ? TINCTURE[arms.charge] : "var(--line-strong)";
const title = arms ? `${name}: ${blazon.text}` : `${name}: no attributed arms`;
const uid = `sh-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class="shield"
  viewBox="0 0 100 116"
  width={size}
  height={Math.round(size * 1.16)}
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  <defs>
    <clipPath id={uid}>
      <path d="M4 4h92v56c0 30-24 44-46 52C28 104 4 90 4 60z" />
    </clipPath>
  </defs>

  <path d="M4 4h92v56c0 30-24 44-46 52C28 104 4 90 4 60z" fill={f} />

  <g clip-path={`url(#${uid})`}>
    {arms?.device === "bends" && (
      <g stroke={c} stroke-width="13" fill="none">
        <path d="M-40 30 L70 -80" />
        <path d="M-40 70 L110 -80" />
        <path d="M-20 110 L130 -40" />
      </g>
    )}

    {arms?.device === "cross" && (
      <g fill={c}>
        <rect x="40" y="4" width="20" height="100" />
        <rect x="4" y="38" width="92" height="20" />
      </g>
    )}

    {arms?.device === "crowns" && (
      <g fill={c}>
        {[
          [32, 30],
          [68, 30],
          [50, 68],
        ].map(([x, y]) => (
          <g transform={`translate(${x - 14} ${y - 10})`}>
            <path d="M0 16h28v5H0z" />
            <path d="M0 16 L0 2 L7 9 L14 0 L21 9 L28 2 L28 16z" />
          </g>
        ))}
      </g>
    )}

    {arms?.device === "eagle" && (
      <g fill={c} transform="translate(50 52)">
        {/* a displayed eagle, reduced to its heraldic silhouette */}
        <path d="M0 -6 L-9 -16 L-16 -12 L-11 -4 L-30 -14 L-24 -2 L-32 2 L-16 8 L-24 18 L-8 12 L-6 26 L0 18 L6 26 L8 12 L24 18 L16 8 L32 2 L24 -2 L30 -14 L11 -4 L16 -12 L9 -16 Z" />
        <circle cx="-9" cy="-19" r="5" />
        <circle cx="9" cy="-19" r="5" />
      </g>
    )}

    {arms?.device === "lion" && (
      <g fill={c} transform="translate(50 58)">
        {/* a lion rampant, reduced to its heraldic silhouette */}
        <path d="M-14 34 L-14 6 C-14 -10 -6 -22 8 -26 L4 -34 L14 -30 L20 -38 L22 -26 L30 -22 L20 -16 C22 -6 18 2 10 8 L16 16 L8 14 L10 26 L2 18 L-2 34 Z" />
      </g>
    )}
  </g>

  <path
    d="M4 4h92v56c0 30-24 44-46 52C28 104 4 90 4 60z"
    fill="none"
    stroke="var(--ink)"
    stroke-opacity="0.35"
    stroke-width="2.5"
  />
</svg>

<style>
  .shield {
    display: block;
    filter: drop-shadow(0 1px 2px rgba(60, 45, 20, 0.18));
  }
</style>
